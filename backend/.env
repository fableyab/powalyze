# ============================================
# Azure AD Configuration
# ============================================
# Get these from Azure Portal > Azure Active Directory > App registrations
PBI_TENANT_ID=your-tenant-id-here
PBI_CLIENT_ID=your-client-id-here
PBI_CLIENT_SECRET=your-client-secret-here

# ============================================
# Power BI Configuration
# ============================================
# Get this from Power BI workspace URL
PBI_WORKSPACE_ID=your-workspace-id-here

# ============================================
# Power BI Report IDs (Legacy)
# ============================================
# Get these from Power BI report URLs
# Format: https://app.powerbi.com/groups/WORKSPACE_ID/reports/REPORT_ID/...
PBI_REPORT_COMMERCIAL=your-commercial-report-id
PBI_REPORT_FINANCE=your-finance-report-id
PBI_REPORT_PMO=your-pmo-report-id
PBI_REPORT_PREDICTIVE=your-predictive-report-id
PBI_REPORT_OPERATIONAL=your-operational-report-id
PBI_REPORT_STRATEGIC=your-strategic-report-id

# ============================================
# 🔐 MULTI-RAPPORTS SÉCURISÉS (Nouveau)
# ============================================
# RAPPORT 1 — Portefeuille stratégique
PBI_REPORT_PORTFOLIO_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# RAPPORT 2 — Suivi des projets
PBI_REPORT_PROJECTS_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# RAPPORT 3 — Capacités & Ressources
PBI_REPORT_CAPACITY_ID=zzzzzzzz-zzzz-zzzz-zzzz-zzzzzzzzzzzz

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Create Azure AD App:
#    - Go to Azure Portal > Azure Active Directory
#    - App registrations > New registration
#    - Copy Tenant ID and Application (client) ID
#    - Create client secret in "Certificates & secrets"
#
# 2. Configure API Permissions:
#    - API permissions > Add permission > Power BI Service
#    - Add: Report.Read.All, Dataset.Read.All, Workspace.Read.All
#    - Grant admin consent
#
# 3. Get Power BI IDs:
#    - Open Power BI workspace in browser
#    - Copy workspace ID from URL
#    - Open each report and copy report ID from URL
#
# 4. Rename this file to .env and fill in the values
