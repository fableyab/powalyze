# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Metabase Configuration
VITE_METABASE_URL=http://localhost:3000
VITE_METABASE_SECRET_KEY=your_metabase_secret_key_here

# Metabase Dashboard IDs (get from Metabase URLs)
VITE_METABASE_DASHBOARD_COMMERCIAL=1
VITE_METABASE_DASHBOARD_FINANCE=2
VITE_METABASE_DASHBOARD_PMO=3

# Optional: OpenAI API Key (for AI features)
VITE_OPENAI_API_KEY=your_openai_api_key

# Power BI Embedded Configuration (NEW - for Reports page)
# Get these from Azure Portal Power BI Service
VITE_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=YOUR_REPORT_ID&groupId=YOUR_GROUP_ID
VITE_POWERBI_ACCESS_TOKEN=your_bearer_token_here
VITE_POWERBI_REPORT_ID=your_main_report_id

# Optional: Power BI Configuration (legacy)
VITE_POWERBI_CLIENT_ID=your_powerbi_client_id
VITE_POWERBI_TENANT_ID=your_powerbi_tenant_id

# Environment
NODE_ENV=production
