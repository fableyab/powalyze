{
  "buildCommand": "npm run build:full 2>&1",
  "outputDirectory": "dist",
  "framework": null,
  "alias": [
    "www.powalyze.com",
    "powalyze.com",
    "www.powalyze.ch",
    "powalyze.ch"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
